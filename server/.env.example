# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Local install:            postgresql://postgres:YOUR_PASSWORD@localhost:5432/alef_public_site
# Hosted (Neon/Supabase/…): paste the connection string they give you (usually includes ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alef_public_site

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on.
PORT=5522

# Used only by `npm run seed` to create the first admin account.
ADMIN_EMAIL=admin@aleffuture.edu.sa
ADMIN_PASSWORD=AlefAdmin2026
